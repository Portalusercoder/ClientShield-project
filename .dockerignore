# Dependencies & build artifacts
node_modules
npm-debug.log*
.next
out
build
coverage
*.tsbuildinfo

# Git / IDE / OS
.git
.gitignore
.cursor
.vscode
.idea
.DS_Store
*.pem

# Env & secrets (never bake)
.env
