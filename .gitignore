# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/

# Production
/build

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
/prisma/*.db
/prisma/*.db-journal

# IDE / OS
.DS_Store
*.pem
.idea
.vscode

# Testing
/coverage

# Generated security reports (local MVP storage — never public)
/storage/reports/

# Manual database backups (Phase 6P1 scripts)
/backups/

# Production env files (never commit)
.env.production
.env.production.local

# Enabled nginx TLS site (optional; copy from ssl.conf.example)
/nginx/conf.d/ssl.conf
/nginx/certs/*.pem
